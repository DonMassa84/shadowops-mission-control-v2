{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "shadowops-coder",
  "share": "disabled",
  "snapshot": true,
  "instructions": [
    ".opencode/SHADOWOPS_CODER_RULES.md"
  ],
  "mcp": {
    "shadowops-runtime": {
      "type": "local",
      "command": ["bash", "scripts/run-shadowops-mcp.sh"],
      "enabled": true,
      "environment": {
        "SHADOWOPS_BASE_URL": "http://127.0.0.1:4014"
      }
    }
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 32768
  },
  "compaction": {
    "auto": true,
    "tail_turns": 20
  }
}
