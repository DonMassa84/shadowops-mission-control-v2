{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "shadowops-coder",
  "model": "ollama/qwen2.5-coder:14b",
  "small_model": "ollama/qwen2.5-coder:7b",
  "share": "disabled",
  "snapshot": true,
  "instructions": [
    ".opencode/SHADOWOPS_CODER_RULES.md"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 Coder 14B (local)"
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B (local)"
        }
      }
    }
  },
  "mcp": {
    "shadowops-runtime": {
      "type": "local",
      "command": ["bash", "scripts/run-shadowops-mcp.sh"],
      "enabled": true,
      "environment": {
        "SHADOWOPS_BASE_URL": "http://127.0.0.1:4013"
      }
    }
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 32768
  },
  "compaction": {
    "auto": true,
    "tail_turns": 20
  }
}
