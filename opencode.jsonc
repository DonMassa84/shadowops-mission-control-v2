{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "shadowops-coder",
  "share": "disabled",
  "snapshot": true,
  "instructions": [
    ".opencode/SHADOWOPS_CODER_RULES.md"
  ],
  "mcp": {
    "shadowops-runtime": {
      "type": "local",
      "command": ["bash", "scripts/run-shadowops-mcp.sh"],
      "enabled": true,
      "environment": {
        "SHADOWOPS_BASE_URL": "http://127.0.0.1:4014"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "repos,pull_requests,issues,actions",
        "X-MCP-Readonly": "true"
      }
    }
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 32768
  },
  "compaction": {
    "auto": true,
    "tail_turns": 20
  }
}
