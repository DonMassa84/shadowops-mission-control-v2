[Unit]
Description=ShadowOps secure reverse tunnel to i7 kiosk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o TCPKeepAlive=yes -R 127.0.0.1:4013:127.0.0.1:4013 shadowserver-i7
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
