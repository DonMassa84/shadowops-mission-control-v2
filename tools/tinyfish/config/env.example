# TinyFish ShadowOps Environment Configuration
# Copy to ~/.config/shadowops/tinyfish/env and customize
# DO NOT COMMIT THIS FILE WITH REAL VALUES

# TinyFish API Key (get from https://tinyfish.ai)
# Use secret manager or OS keyring in production
TINYFISH_API_KEY=

# Optional: Custom API base URL
# TINYFISH_API_BASE_URL=https://api.search.tinyfish.ai

# Optional: Proxy configuration for browser automation
# TINYFISH_PROXY_URL=
# TINYFISH_PROXY_USERNAME=
# TINYFISH_PROXY_PASSWORD=

# Optional: Default browser profile
# TINYFISH_DEFAULT_PROFILE=

# Optional: Log level (debug, info, warn, error)
# TINYFISH_LOG_LEVEL=info

# Optional: Timeout overrides (milliseconds)
# TINYFISH_FETCH_TIMEOUT=30000
# TINYFISH_AGENT_TIMEOUT=120000
# TINYFISH_BROWSER_TIMEOUT=180000
