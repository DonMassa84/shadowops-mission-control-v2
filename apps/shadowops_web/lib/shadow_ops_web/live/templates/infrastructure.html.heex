<header class="page-header">
  <h1>Infrastructure / Compute</h1>
  <span class="collected">Data collected: <%= format_timestamp(@collected_at) %></span>
</header>

<main class="page">
  <section class="nodes">
    <h2>Nodes</h2>
    <div class="nodes-grid">
      <%= for node <- @nodes do %>
        <div class="node-card">
          <div class="node-header">
            <span class="display-name"><%= node.display_name %></span>
            <span class="canonical-id"><%= node.canonical_id %></span>
          </div>
          <div class="node-meta">
            <span class="status" data-status={node.status}>
              <span class="dot"></span>
              <%= node.status %>
            </span>
            <span class="transport">Transport: <%= node.transport %></span>
            <span class="source">Source: <%= node.source %></span>
            <span class="collected-at">Collected: <%= format_timestamp(node.collected_at) %></span>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section class="services">
    <h2>Services</h2>
    <table class="services-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Type</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <%= for service <- @overview.services do %>
          <tr>
            <td><%= service.id %></td>
            <td><%= service.name %></td>
            <td><%= service.type %></td>
            <td><span class="status-badge" data-status={service.status}><%= service.status %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</main>

<style>
  :host { display: block; background: #0d1117; color: #e6edf3; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; min-height: 100vh; }
  .page-header { display: flex; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 1px solid #21262d; }
  .page-header h1 { margin: 0; font-size: 20px; font-weight: 600; }
  .collected { font-size: 12px; color: #8b949e; }
  .page { padding: 24px; display: grid; gap: 24px; }
  section h2 { margin: 0 0 16px; font-size: 16px; font-weight: 600; color: #f0f6fc; border-bottom: 1px solid #21262d; padding-bottom: 8px; }
  .nodes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .node-card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 16px; }
  .node-header { display: flex; flex-direction: column; gap: 4px; margin-bottom: 12px; }
  .display-name { font-size: 15px; font-weight: 600; color: #f0f6fc; }
  .canonical-id { font-size: 12px; color: #8b949e; font-family: monospace; }
  .node-meta { display: flex; flex-wrap: wrap; flex-direction: column; gap: 8px; font-size: 12px; }
  .node-meta .status { display: flex; align-items: center; gap: 4px; }
  .node-meta .dot { width: 6px; height: 6px; border-radius: 50%; }
  .status-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 500; text-transform: uppercase; }
  .status-badge[data-status="active"] { background: rgba(63,185,80,0.15); color: #3fb950; }
  .status-badge[data-status="available"] { background: rgba(88,166,255,0.15); color: #58a6ff; }
  .status-badge[data-status="degraded"] { background: rgba(210,153,34,0.15); color: #d29922; }
  .status-badge[data-status="idle"] { background: rgba(139,148,158,0.15); color: #8b949e; }
  .status-badge[data-status="verified"] { background: rgba(63,185,80,0.15); color: #3fb950; }
  .status-badge[data-status="pending"] { background: rgba(210,153,34,0.15); color: #d29922; }
  .status-badge .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; padding: 10px 12px; font-weight: 600; color: #8b949e; border-bottom: 1px solid #30363d; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; }
  td { padding: 10px 12px; border-bottom: 1px solid #21262d; color: #e6edf3; }
  tr:hover { background: #161b22; }
</style>