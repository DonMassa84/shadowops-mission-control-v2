<header class="page-header">
  <h1>Approvals</h1>
  <span class="collected">Data collected: <%= format_timestamp(@collected_at) %></span>
</header>

<main class="page">
  <section class="approvals">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Workflow</th>
          <th>Risk</th>
          <th>Status</th>
          <th>Actor</th>
          <th>Requested</th>
          <th>Expires</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <%= for approval <- @approvals do %>
          <tr>
            <td><%= approval.id %></td>
            <td><%= approval.workflow %></td>
            <td><%= approval.risk %></td>
            <td><span class="status-badge" data-status={approval.status}><%= approval.status %></span></td>
            <td><%= approval.actor %></td>
            <td><%= format_timestamp(approval.requested_at) %></td>
            <td><%= format_timestamp(approval.expires_at) %></td>
            <td>
              <button phx-click="approve" phx-value-id={approval.id}>Approve</button>
              <button phx-click="reject" phx-value-id={approval.id}>Reject</button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</main>

<style>
  :host { display: block; background: #0d1117; color: #e6edf3; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; min-height: 100vh; }
  .page-header { display: flex; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 1px solid #21262d; }
  .page-header h1 { margin: 0; font-size: 20px; font-weight: 600; }
  .collected { font-size: 12px; color: #8b949e; }
  .page { padding: 24px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; padding: 10px 12px; font-weight: 600; color: #8b949e; border-bottom: 1px solid #30363d; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; }
  td { padding: 10px 12px; border-bottom: 1px solid #21262d; color: #e6edf3; }
  tr:hover { background: #161b22; }
  .status-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 500; text-transform: uppercase; }
  .status-badge[data-status="pending"] { background: rgba(210,153,34,0.15); color: #d29922; }
  .status-badge[data-status="approved"] { background: rgba(63,185,80,0.15); color: #3fb950; }
  .status-badge[data-status="rejected"] { background: rgba(248,81,73,0.15); color: #f85149; }
  .status-badge[data-status="expired"] { background: rgba(139,148,158,0.15); color: #8b949e; }
  .status-badge .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  button { padding: 4px 12px; border: 1px solid #30363d; background: #21262d; color: #e6edf3; border-radius: 4px; font-size: 12px; cursor: pointer; margin-right: 4px; }
  button:hover { background: #30363d; }
</style>