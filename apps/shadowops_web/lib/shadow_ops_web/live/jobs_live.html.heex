<main style="min-height:100vh;background:#0b0d10;color:#e7e9ec;font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;padding:32px;">
  <section style="max-width:1180px;margin:0 auto;">

    <header style="display:flex;align-items:center;justify-content:space-between;gap:18px;border-bottom:1px solid #252932;padding-bottom:20px;margin-bottom:26px;">
      <div>
        <div style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#89919d;">
          ShadowOps Control Plane
        </div>

        <h1 style="font-size:30px;margin:8px 0 0;font-weight:650;">
          Jobs
        </h1>
      </div>

      <div style="font-size:12px;border:1px solid #303641;border-radius:999px;padding:7px 11px;color:#9ba3af;">
        Evidence-first
      </div>
    </header>

    <section style="border:1px solid #252932;background:#111419;border-radius:14px;padding:22px;margin-bottom:18px;">
      <div style="font-size:12px;text-transform:uppercase;letter-spacing:.1em;color:#818a97;margin-bottom:9px;">
        Governance
      </div>

      <div style="font-size:16px;line-height:1.7;">
        Approval → PrivacyGate → Audit → Health/Events → ExecutionService
      </div>

      <div style="font-size:13px;color:#818a97;margin-top:8px;">
        Nothing executes without a receipt.
      </div>
    </section>

    <section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;">

      <article style="border:1px solid #252932;background:#0f1216;border-radius:12px;padding:18px;">
        <div style="font-size:12px;color:#818a97;text-transform:uppercase;">
          View
        </div>
        <div style="font-size:19px;margin-top:7px;">
          Jobs
        </div>
      </article>

      <article style="border:1px solid #252932;background:#0f1216;border-radius:12px;padding:18px;">
        <div style="font-size:12px;color:#818a97;text-transform:uppercase;">
          Runtime evidence
        </div>
        <div style="font-size:19px;margin-top:7px;">
          UNKNOWN
        </div>
        <div style="font-size:12px;color:#737c89;margin-top:6px;">
          No runtime state is fabricated.
        </div>
      </article>

      <article style="border:1px solid #252932;background:#0f1216;border-radius:12px;padding:18px;">
        <div style="font-size:12px;color:#818a97;text-transform:uppercase;">
          Verification
        </div>
        <div style="font-size:19px;margin-top:7px;">
          UNVERIFIED
        </div>
        <div style="font-size:12px;color:#737c89;margin-top:6px;">
          Waiting for backend evidence.
        </div>
      </article>

    </section>
  </section>
</main>
